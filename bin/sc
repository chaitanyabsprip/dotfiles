#!/bin/sh

[ $# -gt 1 ] && echo 'Usage: sc <errorcode> or program | sc' && exit 1

depends pandoc || exit 1
have glow || { echo "${0##*/} depends on glow, use it for better experience"; }

preview() {
	content=
	[ -p /dev/stdin ] || return
	{ have glow && cat | glow -p; } || { have bat && cat | bat -p; } || cat
}

[ ! -p /dev/stdin ] && [ -z "$1" ] && printf 'shellcheck error: '
[ -z "$1" ] && read -r code
code="${code:-$1}"

curl -s "https://www.shellcheck.net/wiki/SC$code" |
	pandoc -f html -t markdown |
	preview
