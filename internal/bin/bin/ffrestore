#!/bin/sh

sessiondir="$HOME/.local/share/ffsessions"

[ -d "$sessiondir" ] || { echo "No sessions found" && exit 1; }

depends firefox || exit 1

_firefox() {
	for url in "$@"; do
		echo "$url"
	done
	firefox "$@"
}

while read -r line; do
	[ -z "$line" ] && continue
	_firefox "$line"
done <"$(find "$sessiondir" | sort | tail -n 1)"
