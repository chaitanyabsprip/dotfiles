bind -N "Harpoon: Start tracking current session" C-_    run 'dot x tmux harpoon add'
bind -N "Harpoon: Start tracking current pane"    .    run 'dot x tmux harpoon pane'
bind -N "Harpoon: List tracked sessions in fzf"   f    run 'dot x tmux harpoon list'
bind -N "Harpoon: Edit tracked sessions"          C-e  run 'dot x tmux harpoon edit'
bind -N "Harpoon: Select bookmark 1"              C-h  run 'dot x tmux harpoon go 1'
bind -N "Harpoon: Select bookmark 2"              C-j  run 'dot x tmux harpoon go 2'
bind -N "Harpoon: Select bookmark 3"              C-k  run 'dot x tmux harpoon go 3'
bind -N "Harpoon: Select bookmark 4"              C-l  run 'dot x tmux harpoon go 4'
