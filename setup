#!/bin/sh

# Install the tools these dotfiles expect. Run after `./dotme serve`.
#
#   ./setup [target] [--go]
#
# Targets: all (default), packages, zsh, tmux, nvim, mise (alias: extra),
#          go, fzf, bat. `--go` adds the Go toolchain to `all`.
#
# macOS: Homebrew + Brewfile. Linux: the distro's package manager, falling
# back to bin/install-* for tools the distro doesn't package (or packages
# too old). Every step is skipped when the tool is already installed.

main() {
    target="${1:-all}"
    [ $# -gt 0 ] && shift
    echo "Running setup for $target"
    case "$target" in
    all)
        echo "$*" | grep -wq -- '--go' && _go
        _packages
        _mise
        _zsh_extras
        setup_neovim
        ;;
    packages) _packages ;;
    zsh) pkg_install zsh && _zsh_extras ;;
    tmux) pkg_install tmux ;;
    nvim) setup_neovim ;;
    mise | extra) _mise ;;
    go) _go ;;
    fzf) _fzf ;;
    bat) have bat || pkg_install bat || install-bat ;;
    *) echo "unknown target: $target" && exit 1 ;;
    esac
}

DOTFILES="$(cd "$(dirname "$0")" && pwd)"
PATH="$DOTFILES/bin:$HOME/.local/bin:$PATH" # have, heading, success, install-*
mkdir -p "$HOME/.local/bin"

# os-release ID (debian, ubuntu, fedora, arch, opensuse-*), or Darwin on macOS
DISTRO="$(. /etc/os-release 2>/dev/null && echo "$ID" || uname -s)"

_packages() {
    heading packages
    if [ "$DISTRO" = Darwin ]; then
        have brew || /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        brew bundle --file "$DOTFILES/Brewfile"
    else
        pkg_install git curl zsh tmux jq
        for tool in bat eza fd rg yq gitui gitmux; do
            have "$tool" || "install-$tool"
        done
        _fzf
    fi
    success "packages installed"
}

pkg_install() {
    case "$DISTRO" in
    Darwin) brew install "$@" ;;
    debian | ubuntu) sudo apt-get install -y "$@" ;;
    fedora | centos | rhel) sudo dnf install -y "$@" ;;
    opensuse*) sudo zypper install -y "$@" ;;
    arch) sudo pacman -S --noconfirm --needed "$@" ;;
    *) error "Don't know how to install $* on $DISTRO" && return 1 ;;
    esac
}

# Runtimes (node, python, ...) from mise/config.toml, linked to ~/.config/mise
_mise() {
    heading mise
    if ! have mise; then
        if [ "$DISTRO" = Darwin ]; then brew install mise; else curl -sS https://mise.run | sh; fi
    fi
    "$(command -v mise || echo "$HOME/.local/bin/mise")" install
    success "mise runtimes installed"
}

_zsh_extras() {
    _oh_my_posh
    _zap
}

_oh_my_posh() {
    heading oh-my-posh
    have oh-my-posh && echo "Already installed at $(which oh-my-posh)" && return
    if [ "$DISTRO" = Darwin ]; then
        brew install oh-my-posh
    else
        curl -sS https://ohmyposh.dev/install.sh | bash -s -- -d "$HOME/.local/bin"
    fi
    success "oh-my-posh successfully installed"
}

_zap() {
    heading zap
    [ -f "${XDG_DATA_HOME:-$HOME/.local/share}/zap/zap.zsh" ] && echo "Already installed" && return
    curl -s https://raw.githubusercontent.com/zap-zsh/zap/master/install.zsh -o install.zsh
    zsh install.zsh --branch release-v1 --keep
    rm install.zsh
    success "zap-zsh successfully installed"
}

# Distro fzf is often too old for `fzf --zsh`; use upstream's installer.
_fzf() {
    heading fzf
    have fzf && echo "Already installed at $(which fzf)" && return
    [ -d "$HOME/programs/fzf" ] || git clone --depth 1 https://github.com/junegunn/fzf "$HOME/programs/fzf"
    "$HOME/programs/fzf/install" --bin
    ln -sf "$HOME/programs/fzf/bin/fzf" "$HOME/programs/fzf/bin/fzf-tmux" "$HOME/.local/bin/"
    success "successfully installed fzf"
}

# Neovim nightly, built from source into /usr/local (bin/update-neovim)
setup_neovim() {
    heading "Complete Neovim Setup"
    have nvim || {
        _neovim_build_deps
        update-neovim stable
    }
    nvim --headless "+Lazy! sync" "+sleep 60" +qa
    success "neovim setup complete"
}

_neovim_build_deps() {
    case "$DISTRO" in
    Darwin) xcode-select --install 2>/dev/null || :; brew install ninja gettext cmake ;;
    debian | ubuntu) pkg_install ninja-build gettext cmake unzip curl make ;;
    fedora | centos | rhel) pkg_install ninja-build cmake gcc make gettext curl glibc-gconv-extra ;;
    opensuse*) pkg_install ninja cmake gcc-c++ gettext-tools curl ;;
    arch) pkg_install base-devel cmake unzip ninja curl ;;
    esac
}

_go() {
    heading go
    have go && echo "Already installed at $(which go)" && return
    [ "$DISTRO" = Darwin ] && brew install go && return
    mkdir -p "$HOME/programs"
    curl -SsL https://git.io/go-installer.sh | bash
}

main "$@"
